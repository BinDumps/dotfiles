# SHADERS
custom-shader = shaders/cursor-smear.glsl

# CURSOR SETTINGS
# Available options: block, bar, underline, block_hollow
cursor-style = block

# TEXT DISPLAY SETTINGS
# Adjust row/line height. Values can be absolute pixels (e.g., 2px) or percentages (e.g., 15%).
adjust-cell-height = 15%
cursor-style-blink = true

# FONT SETTINGS
font-feature = -calt, -liga, -dlig
# Font Family (use exact system font name)
font-family = "Hack Nerd Font Mono"
# Font Size (in points)
font-size = 16

# WINDOW SETTINGS
# Control window decorations (auto, client, server, or none)
window-decoration = client
# Set where or if the tab bar is shown (top, bottom, left, right, or false to hide)
gtk-tabs-location = top
# Make tabs expand wide to fill the full bar width
gtk-wide-tabs = true
# Hide the titlebar/headerbar when the window is maximized
gtk-titlebar-hide-when-maximized = false
# Remembers window size, position, and maximized state on close
window-save-state = default
# Set background transparency (0.0 = completely invisible, 1.0 = fully opaque)
background-opacity = 0.75
background-blur = true
# Fixed window size in columns (width) and rows (height)
window-width = 82
window-height = 27
# Horizontal padding in pixels (applies to both left and right edges)
window-padding-x = 12
# Vertical padding in pixels (top and bottom)
window-padding-y = 12
window-padding-balance = true

# KEYBINDS
# Custom Keybindings for tabs
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
# Vanity Keybinds
keybind = ctrl+backspace=text:\x17
keybind = f11=toggle_fullscreen
keybind = ctrl+shift+n=unbind
keybind = ctrl+alt+n=new_window
keybind = ctrl+==unbind
keybind = ctrl+-=unbind
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1

# THEMES
theme = linux-colors
