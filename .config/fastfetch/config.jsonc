{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"//,
    //"source": "/home/ext/trinket.txt", // Absolute path to your file
    //"padding": {
    //  "top": 2,
    //  "left": 2,
    //  "right": 2
    //}
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    "key": {
      // Sets the exact width of the first column to make the second column straight
      "width": 10 
    }
  },
  "modules": [
    "title",
    { "type": "os", "key": "os", "format": "{2}" },
    { "type": "host", "key": "host", "format": "{2} {3}" },
    { "type": "kernel", "key": "kernel", "format": "{2}" },
    { "type": "uptime", "key": "uptime", "format": "{2}h {3}m" },
    { "type": "packages", "key": "pkgs", "adapter": "pacman" },
    { "type": "memory", "key": "memory", "format": "{1} / {2}" },
    {
      "type": "command",
      "key": "age",
      "text": "diff=$(($(date +%s) - $(stat -c %W /))); echo \"$((diff / 86400)) days, $(( (diff % 86400) / 3600 ))h $(( (diff % 3600) / 60 ))m $(( diff % 60 ))s\""
    }
  ]
}
