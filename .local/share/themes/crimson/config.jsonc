{
    "layer": "top",
    "position": "top",
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 12,
    "margin-right": 12,
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "custom/power",
        "custom/themes",
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "cpu",
        "memory",
        "backlight",
        "pulseaudio",
        "pulseaudio#source"
    ],
    "modules-right": [
        "network",
        "custom/language",
        "custom/clipboard",
        "tray",
        "clock"
    ],

    "niri/workspaces": {
        "format": "[{index}]",
        "active-only": false
    },

    "niri/window": {
        "format": "<b><span color='#ff3344'>//</span> {}</b>",
        "max-length": 30,
        "separate-outputs": true
    },

    "cpu": {
        "format": "PWR {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 3
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL MUT",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "MIC {volume}%",
        "format-source-muted": "MIC MUT",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "tooltip": false
    },

    "backlight": {
        "format": "BRT {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "network": {
        "format-wifi": "NET {essid}",
        "format-ethernet": "ETH {ipaddr}",
        "format-linked": "ETH (NO IP)",
        "format-disconnected": "NET OFF",
        "tooltip-format-wifi": "󰤨 {essid} ({signalStrength}%)\n󰩟 {ipaddr}",
        "tooltip-format-ethernet": "󰈀 {ifname}\n󰩟 {ipaddr}",
        "on-click": "~/.local/bin/waybar-network-menu.sh"
    },

    "clock": {
        "format": "<b>{:%I:%M:%S %p}</b>",
        "format-alt": "<b>{:%Y-%m-%d}</b>",
        "interval": 1,
        "tooltip-format": "<tt><span size='11000'>{calendar}</span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ff3344'><b>{}</b></span>",
                "days": "<span color='#ffffff'><b>{}</b></span>",
                "weekdays": "<span color='#881122'><b>{}</b></span>",
                "today": "<span color='#ff3344'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/language": {
        "exec": "~/.local/bin/waybar-niri-layout.sh",
        "format": "󰌌 {}",
        "tooltip": false,
        "on-click": "niri msg action switch-layout next"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip-format": "Clipboard History",
        "on-click": "~/.local/bin/cliphist-fuzzel.sh",
        "on-click-right": "cliphist wipe && wl-copy -c && notify-send 'Clipboard Cleared'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    "custom/themes": {
        "format": "󰔎",
        "tooltip": true,
        "tooltip-format": "Switch system theme",
        "on-click": "~/.local/bin/switch-theme.sh"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.local/bin/waybar-powermenu.sh"
    }
}
