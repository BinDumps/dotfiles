{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 16,
    "margin-right": 16,
    "height": 30,
    "spacing": 6,

    "modules-left": [
	"custom/privacy",
        "custom/themes",
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "pulseaudio#source",
        "backlight",
        "network",
        "custom/language",
        "custom/clipboard",
        "tray",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "●",
        "active-only": false
    },

    "niri/window": {
        "format": "│ {}",
        "max-length": 35,
        "separate-outputs": true
    },

    "clock": {
        "format": "󰥔 {:%I:%M:%S %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<tt><span size='11000'>{calendar}</span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#aaaaaa'><b>{}</b></span>",
                "weekdays": "<span color='#555555'><b>{}</b></span>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 3
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": false
    },

    "pulseaudio#source": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "tooltip": false
    },

    "backlight": {
        "format": "󰃠 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "~/.local/bin/waybar-network-menu.sh"
    },

    "custom/language": {
        "exec": "~/.local/bin/waybar-niri-layout.sh",
        "format": "{}",
        "tooltip": false,
        "on-click": "niri msg action switch-layout next"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip-format": "Clipboard History",
        "on-click": "~/.local/bin/cliphist-fuzzel.sh",
        "on-click-right": "cliphist wipe && wl-copy -c && notify-send 'Clipboard Cleared'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/themes": {
        "format": "󰔎",
        "tooltip": true,
        "tooltip-format": "Switch system theme",
        "on-click": "~/.local/bin/switch-theme.sh"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.local/bin/waybar-powermenu.sh"
    },
    
    "custom/privacy": {
        "exec": "~/.local/bin/privacy-dots.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "on-click": "~/.local/bin/privacy-menu.sh"
    }
}
